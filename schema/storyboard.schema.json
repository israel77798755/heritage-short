{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/israel77798755/heritage-short/schema/storyboard.schema.json",
  "title": "Heritage Short Storyboard",
  "description": "Formal JSON Schema contract for The Wisdom of Our Mothers (የእናቶቻችን ጥበብ) short film storyboard.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "title_en",
    "title_am",
    "target_duration_seconds",
    "minimum_duration_seconds",
    "maximum_duration_seconds",
    "language",
    "subtitle_language",
    "aspect_ratios",
    "creative_note",
    "lessons",
    "visual_style",
    "characters",
    "narration_config",
    "music",
    "end_card",
    "scenes"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "title_en": {
      "type": "string",
      "minLength": 1
    },
    "title_am": {
      "type": "string",
      "minLength": 1,
      "pattern": "[\u1200-\u137F]"
    },
    "target_duration_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 90
    },
    "minimum_duration_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 90
    },
    "maximum_duration_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 90
    },
    "language": {
      "type": "string",
      "const": "am"
    },
    "subtitle_language": {
      "type": "string",
      "const": "en"
    },
    "aspect_ratios": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "9:16",
          "16:9"
        ]
      }
    },
    "creative_note": {
      "type": "string",
      "minLength": 1
    },
    "lessons": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "lesson_en",
          "lesson_am",
          "scene_numbers"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "trust_god",
              "respect_others",
              "never_give_up",
              "remain_hopeful"
            ]
          },
          "lesson_en": {
            "type": "string",
            "minLength": 1
          },
          "lesson_am": {
            "type": "string",
            "minLength": 1,
            "pattern": "[\u1200-\u137F]"
          },
          "scene_numbers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "visual_style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style_block",
        "palette",
        "lighting",
        "framing_note"
      ],
      "properties": {
        "style_block": {
          "type": "string",
          "minLength": 1
        },
        "palette": {
          "type": "string",
          "minLength": 1
        },
        "lighting": {
          "type": "string",
          "minLength": 1
        },
        "framing_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "characters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mother",
        "child"
      ],
      "properties": {
        "mother": {
          "$ref": "#/$defs/character"
        },
        "child": {
          "$ref": "#/$defs/character"
        }
      }
    },
    "narration_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "voice_persona",
        "style_instruction",
        "target_speaking_pace"
      ],
      "properties": {
        "language": {
          "type": "string",
          "pattern": "^am"
        },
        "voice_persona": {
          "type": "string",
          "minLength": 1
        },
        "style_instruction": {
          "type": "string",
          "minLength": 1
        },
        "target_speaking_pace": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrumental_only",
        "style",
        "tempo_bpm",
        "key",
        "mood",
        "caption",
        "mixing_note"
      ],
      "properties": {
        "instrumental_only": {
          "type": "boolean"
        },
        "style": {
          "type": "string",
          "minLength": 1
        },
        "tempo_bpm": {
          "type": "integer",
          "minimum": 30,
          "maximum": 240
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "mood": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "mixing_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "end_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_seconds",
        "title_en",
        "title_am",
        "disclosure_en",
        "disclosure_am",
        "visual_description",
        "audio_description"
      ],
      "properties": {
        "duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "title_en": {
          "type": "string",
          "minLength": 1
        },
        "title_am": {
          "type": "string",
          "minLength": 1,
          "pattern": "[\u1200-\u137F]"
        },
        "disclosure_en": {
          "type": "string",
          "minLength": 1
        },
        "disclosure_am": {
          "type": "string",
          "minLength": 1,
          "pattern": "[\u1200-\u137F]"
        },
        "visual_description": {
          "type": "string",
          "minLength": 1
        },
        "audio_description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scene_number",
          "title",
          "lesson",
          "purpose",
          "duration_seconds",
          "shot_size",
          "camera_movement",
          "visual",
          "image_prompt",
          "motion_prompt",
          "narration",
          "subtitle_en",
          "audio",
          "music_cue",
          "seed"
        ],
        "properties": {
          "scene_number": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "lesson": {
            "type": "string",
            "enum": [
              "opening",
              "trust_god",
              "respect_others",
              "never_give_up",
              "remain_hopeful",
              "closing"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "duration_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "shot_size": {
            "type": "string",
            "minLength": 1
          },
          "camera_movement": {
            "type": "string",
            "minLength": 1
          },
          "visual": {
            "type": "string",
            "minLength": 1
          },
          "image_prompt": {
            "type": "string",
            "minLength": 1
          },
          "motion_prompt": {
            "type": "string",
            "minLength": 1
          },
          "narration": {
            "type": "string",
            "minLength": 1,
            "pattern": "[\u1200-\u137F]"
          },
          "subtitle_en": {
            "type": "string",
            "minLength": 1
          },
          "audio": {
            "type": "string",
            "minLength": 1
          },
          "music_cue": {
            "type": "string",
            "minLength": 1
          },
          "seed": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "$defs": {
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "name_am",
        "fictional",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "name_am": {
          "type": "string",
          "minLength": 1,
          "pattern": "[\u1200-\u137F]"
        },
        "fictional": {
          "type": "boolean",
          "const": true
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
