# Copy this file to .env and fill in your own keys locally.
# NEVER commit .env or real API keys to GitHub.

# Google AI Studio / Gemini API (used for script, prompts, Amharic TTS)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare Workers AI (used for FLUX keyframe image generation)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Kaggle API (optional, for remote Wan 2.2 / ACE-Step notebook runs)
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_api_key_here

# Hugging Face (optional, for hosted Space or model access)
HF_TOKEN=your_huggingface_token_here
